# Pion decay channel: turn the pi- extracted from the FFA ring into mu-.
#
# A simple solenoidal decay channel: uniform Bz solenoid field, iron
# shield wall with a bore, virtual detectors along the channel and at the
# end.  The input beam is the BLTrackFile written by
# scripts/make_channel_input.py from the ring's enclosure detectors
# (pi- and mu-, already transformed into the channel frame: the channel
# axis is +z, entrance plane z=0).
#
# pi- at ~240 MeV/c have a decay length of ~13 m, so a 30 m channel
# converts most of them; the 5 T, 0.5 m bore confines transverse momenta up to
# ~370 MeV/c.  Note: pi- must NOT hit material (nuclear capture), which
# is why the bore is generous.
#
# Parameters:
#   BSOL    solenoid field [T]
#   LCH     channel length [mm]
#   RCH     bore radius [mm]
#   INFILE  input BLTrackFile
#
# Optional muon STOPPING stage (STOP=1): downstream of the channel the
# muons pass a graphite degrader (DEG mm) and enter the D-T target
# (liquid D-T, CELL mm long, radius RCH) where they range out and stop at
# their Bragg peak (the muCF fuel cell).  "beamlossntuple" records every
# track end point, from which the analysis counts mu- stopped INSIDE the
# D-T target and the stop-depth (Bragg) distribution.  Tune DEG so the
# bulk of the mu- momentum spectrum ranges out inside the target.

param -unset BSOL=5.0
param -unset LCH=30000.0
param -unset RCH=500.0
param -unset INFILE=out/pions_for_channel.txt
param -unset TRACE=0
param -unset STOP=0
param -unset DEG=120.0
param -unset CELL=1500.0
param -unset CELLMAT=DT
param -unset BCELL=3.0

physics QGSP_BERT
param worldMaterial=Vacuum
param steppingFormat=N
param eventTimeLimit=60

trackcuts kill=gamma,e+,e-,nu_e,anti_nu_e,nu_mu,anti_nu_mu maxTime=2000

beam ascii filename=$INFILE beamZ=0.0

# uniform solenoid field over the bore (fieldexpr cylinder, constant Bz)
fieldexpr solfield Bz=$BSOL length=$LCH radius=$RCH+100 nR=3 nZ=3
place solfield z=$LCH/2 coordinates=global

# channel wall: anything that touches it is lost (pi- capture)
tubs chwall innerRadius=$RCH outerRadius=$RCH+20 length=$LCH material=Fe kill=1
place chwall z=$LCH/2 coordinates=global

# profile detectors along the channel + final muon counter
do i 1 4
  param zd=$i*5000
  virtualdetector VDch$i radius=$RCH length=1 material=Vacuum format=ascii \
      kill=0 coordinates=global file=out/VDch$i.txt
  place VDch$i z=$zd coordinates=global
enddo

# with the stopping stage on, the end counter must not kill the muons
param ENDKILL=1-($STOP>0)
virtualdetector VDmuEnd radius=$RCH length=1 material=Vacuum format=ascii \
    kill=$ENDKILL coordinates=global file=out/VDmuEnd.txt
place VDmuEnd z=$LCH coordinates=global

if $STOP>0
  # liquid D-T 50/50 (A~2.5, rho~0.21 g/cm3) and liquid D2 for reference
  material DT a=2.509 z=1 density=0.21
  material LD2 a=2.014 z=1 density=0.169

  # keep a solenoid over the degrader+cell so muons stay radially confined
  fieldexpr stopfield Bz=$BCELL length=$DEG+$CELL+200 radius=$RCH+100 nR=3 nZ=3
  place stopfield z=$LCH+100+($DEG+$CELL)/2 coordinates=global

  box degrader width=2*$RCH height=2*$RCH length=$DEG material=GRAPHITE \
      color=0.4,0.4,0.4
  place degrader z=$LCH+100+$DEG/2 coordinates=global

  tubs stopcell innerRadius=0 outerRadius=$RCH length=$CELL material=$CELLMAT \
      color=0,0.5,1
  place stopcell z=$LCH+100+$DEG+$CELL/2 coordinates=global

  # every track records its end point here (stopped mu- have |p|~0)
  beamlossntuple ends format=ascii filename=out/chan_ends.txt coordinates=global
endif

if $TRACE>0
  trace nTrace=$TRACE oneNTuple=1 format=ascii filename=out/chan_trace.txt coordinates=global
endif
